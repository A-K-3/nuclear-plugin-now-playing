{
  "name": "nuclear-plugin-now-playing",
  "version": "1.2.1",
  "description": "Fullscreen now-playing screen for Nuclear: big artwork, synced lyrics, SoundCloud timed comments, visualizer and a searchable queue",
  "author": "A-K-3",
  "license": "MIT",
  "main": "src/index.ts",
  "repository": "github:A-K-3/nuclear-plugin-now-playing",
  "nuclear": {
    "displayName": "Now Playing",
    "categories": [
      "other"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "esbuild src/index.ts --bundle --format=cjs --platform=browser --target=es2022 --external:react --external:@nuclearplayer/plugin-sdk --outfile=dist/plugin.js",
    "test": "npm run build && playwright test",
    "check": "npm run typecheck && npm test",
    "pack": "bash scripts/pack.sh"
  },
  "devDependencies": {
    "@nuclearplayer/plugin-sdk": "2.9.0",
    "@playwright/test": "1.48.2",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
